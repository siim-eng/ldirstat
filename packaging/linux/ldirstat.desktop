[Desktop Entry]
Version=1.0
Type=Application
Name=LDirStat
Comment=Analyze disk usage statistics by directory
Exec=LDirStat %f
TryExec=LDirStat
Icon=ldirstat
Terminal=false
Categories=System;FileTools;
MimeType=inode/directory;
Keywords=disk;usage;filesystem;storage;space;directory;
StartupNotify=true
StartupWMClass=LDirStat
